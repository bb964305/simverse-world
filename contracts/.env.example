# Optional overrides; public endpoints are rate-limited and unsuitable for production traffic.
ROBINHOOD_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Deployer key for Robinhood Chain testnet/mainnet. Never commit a real key.
ROBINHOOD_PRIVATE_KEY=
