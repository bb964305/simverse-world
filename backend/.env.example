LAB_ARTIFACT_ALLOWED_MIME_TYPES=["application/json","application/pdf","application/zip","image/jpeg","image/png","text/csv","text/markdown","text/plain"]
LAB_ARTIFACT_INGEST_AUTH_ISSUER=
LAB_ARTIFACT_INGEST_AUTH_AUDIENCE=lab-artifact-ingest
LAB_ARTIFACT_INGEST_AUTH_CURRENT_KID=
