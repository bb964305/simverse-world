# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/skills_world
# Dev only: auto-create tables from models at startup (production uses `alembic upgrade head`)
AUTO_CREATE_TABLES=false

# Redis
REDIS_URL=redis://localhost:6379/0

# Dev mode: allows the default JWT secret. Never enable in production.
DEBUG=true

# Auth
JWT_SECRET=change-me-in-production-use-a-long-random-string

# GitHub OAuth (optional for MVP)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# LLM Config
LLM_DEFAULT_MODEL=claude-haiku-4-5-20251001
LLM_MAX_TOKENS=512

# SearXNG (research)
SEARXNG_URL=http://localhost:58080

# Portrait generation (Gemini via proxy)
PORTRAIT_LLM_MODEL=gemini-3-pro-image-preview
PORTRAIT_LLM_BASE_URL=http://localhost:3000/v1
PORTRAIT_LLM_API_KEY=

# CORS
CORS_ORIGINS=["http://localhost:5173"]

# Observability (Phase 3)
# Sentry stays off unless a DSN is set (applies to API and agent-worker).
SENTRY_DSN=
SENTRY_ENVIRONMENT=dev
SENTRY_TRACES_SAMPLE_RATE=0.0
# Prometheus GET /metrics (per-worker registry; see app/observability.py)
METRICS_ENABLED=true
# Bearer token for GET /metrics (empty = open; set when /metrics is public)
METRICS_TOKEN=
# Log SQL statements slower than N ms via logger "app.slow_query" (0 = off)
SLOW_QUERY_MS=0

# Process topology (P0-3)
# Run agent/heat/embedding loops inside the API process. Set false when the
# standalone agent-worker container owns them (deploy compose does this).
RUN_BACKGROUND_TASKS=true

# Auth extras
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
GITHUB_REDIRECT_URI=

# LinuxDo OAuth (optional)
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
LINUXDO_REDIRECT_URI=
LINUXDO_MIN_TRUST_LEVEL=0

# Custom LLM endpoint (relay/aggregator; overrides ANTHROPIC_API_KEY when set)
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Disable thinking/reasoning for faster responses
LLM_THINKING=false
# Per-attempt LLM usage telemetry -> llm_usage table (P1-1)
LLM_METERING_ENABLED=true
# Pin background/system calls to a cheaper model (empty = same as player-visible)
BACKGROUND_LLM_MODEL=

# Budget circuit breaker (P1-1); 0 disables each cap
BUDGET_GLOBAL_DAILY_USD=1.5
BUDGET_USER_DAILY_USD=0.5
BUDGET_FORGE_REQUEST_USD=0.15

# System/user LLM advanced params
SYSTEM_LLM_TEMPERATURE=0.3
SYSTEM_LLM_TIMEOUT=30
SYSTEM_LLM_MAX_RETRIES=2
USER_LLM_TEMPERATURE_CHAT=0.7
USER_LLM_TEMPERATURE_FORGE=0.5
USER_LLM_TIMEOUT=120
USER_LLM_MAX_RETRIES=3
USER_LLM_CONCURRENCY=5
# Allow players to configure their own LLM endpoint in settings
ALLOW_USER_CUSTOM_LLM=false

# Portrait extras
PORTRAIT_LLM_TIMEOUT=180

# TTS (E5; empty base URL disables external calls)
TTS_BASE_URL=
TTS_API_KEY=
TTS_MODEL=tts-1
TTS_DAILY_FREE_QUOTA=30

# Media upload
MEDIA_UPLOAD_DIR=backend/static/uploads
MEDIA_MAX_IMAGE_SIZE=5242880
MEDIA_MAX_VIDEO_SIZE=52428800
VIDEO_LLM_MODEL=kimi-k2.5

# Embedding provider
# Master switch — set false on deploys with no embedding endpoint (memory
# retrieval falls back to importance/recency instead of failing per call)
EMBEDDING_ENABLED=true
# OpenAI-compatible endpoint (百炼 compatible-mode / one-api / OpenAI);
# takes priority over Ollama below when set. dimensions passed explicitly.
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1024

# Ollama (local embedding fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=qwen3-embedding:4b
OLLAMA_EMBED_DIMENSIONS=1024

# Agent loop
# Master switch — vm212 keeps this false (Coding Plan terms forbid backend automation)
AGENT_ENABLED=true
AGENT_TICK_INTERVAL=60
AGENT_MAX_CONCURRENT=5
AGENT_MAX_DAILY_ACTIONS=20
AGENT_CHAT_MAX_TURNS=8
AGENT_CHAT_COOLDOWN=1800
AGENT_TIME_SCALE=1.0
AGENT_DEBUG_ALWAYS_ACTIVE=false

# Rate limiting (P1-1 limit sub-item)
WS_RATE_LIMIT_PER_MINUTE=20
REST_RATE_LIMIT_REGISTER_PER_MINUTE=5
REST_RATE_LIMIT_FORGE_PER_MINUTE=10
REST_RATE_LIMIT_LLM_TEST_PER_MINUTE=5
