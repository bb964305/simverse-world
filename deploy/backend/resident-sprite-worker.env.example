# Copy to resident-sprite-worker.env on the deployment host. Docker Compose
# loads this file only into agent-worker; it must not be shared with the API.
# The shared deployment .env must explicitly enable the feature before this
# worker consumes jobs.
RESIDENT_SPRITE_ENABLED=false
RESIDENT_SPRITE_PROVIDER_BASE_URL=
RESIDENT_SPRITE_PROVIDER_API_KEY=
RESIDENT_SPRITE_PROVIDER_MODEL=gpt-image-2
RESIDENT_SPRITE_PROVIDER_TIMEOUT=180
# Test only. Keep false in every production deployment.
RESIDENT_SPRITE_ALLOW_INSECURE_HTTP_TEST=false

# Conservative per-image-request upper bound in USD. Zero means unknown and
# keeps paid generation blocked until an operator freezes a reviewed value.
RESIDENT_SPRITE_REQUEST_COST_UPPER_BOUND_USD=0
