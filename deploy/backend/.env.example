# LinuxDo OAuth (optional)
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
LINUXDO_REDIRECT_URI=

# Resident autonomous behavior (AgentLoop, runs in the agent-worker service).
# Production default has been OFF historically — set true to bring residents
# to life (movement, self-directed chats, feed events).
AGENT_ENABLED=true
# Agent-worker 决策 LLM 端点（与上面的 LLM_* 世界观线是两条独立配置）。
# 这三键必须活在 deploy/.env（compose env_file 注入进程 env）——不要放
# backend/.env：那份文件会被烤进镜像，且不受部署脚本管理。
AGENT_BASE_URL=https://coding.dashscope.aliyuncs.com/apps/anthropic
AGENT_API_KEY=sk-xxx
AGENT_MODEL=qwen3.7-plus

# Static files (uploaded media, AI portraits, and approved resident sprites)
# are served from /app/static inside the container and persisted by the
# media_static volume. Unapproved sprite candidates stay in the separate,
# non-public resident_sprite_artifacts volume.
STATIC_DIR=/app/static
MEDIA_UPLOAD_DIR=/app/static/uploads
RESIDENT_SPRITE_ENABLED=false
RESIDENT_SPRITE_ARTIFACT_DIR=/var/lib/simverse/resident-sprites
# Provider credentials and generation pricing belong in the worker-only
# resident-sprite-worker.env file; never place them in this shared file.
# Qualified receipt is mounted read-only into the agent-worker. Set both vars
# only after probe/qualification/review has produced a current receipt.
# Container path is fixed by compose; configure the host-side source below.
RESIDENT_SPRITE_CAPABILITY_RECEIPT=/run/secrets/resident-sprite-capability.json
RESIDENT_SPRITE_CAPABILITY_RECEIPT_HOST_PATH=
RESIDENT_SPRITE_REVOCATION_ROOT=/var/lib/simverse/resident-sprites/revocations

# Observability. /metrics is served by the API process itself; with an empty
# METRICS_TOKEN it is unauthenticated and leaks every /admin/* route name and
# its call volume. Binding the API to loopback only blocks *direct* access to
# the port — cloudflared (or any reverse proxy) still forwards the whole
# origin, so https://<api-host>/metrics stays reachable from the public
# internet through the tunnel. Fail closed: leave this disabled until you set
# a real METRICS_TOKEN below, then flip it to true for your Prometheus
# scrape_config's bearer_token.
METRICS_ENABLED=false
METRICS_TOKEN=

# ── 政治层三条线 (F1 声誉 / F2 公民权 / F3 任期) — ROADMAP #5 收口 ─────────
# 默认全关/保守。开闸是独立变更（红线：行为开闸与代码/部署变更分开）；
# CIVIC_PROMOTION_MODE=on 前必须先 shadow 观察 ≥3 个夜间周期 + 标定占位门槛。
# 键与语义详见 backend/.env.example 对应段（本文件保持同键同默认，由
# tests/test_env_example_consistency.py::test_governance_knobs_exist_in_deploy_env_example_too 守住）。

# M3 civic 治理基座（proposals → 投票 → 执行）。F2 的晋升闸门与 F3 的补选
# 都跑在它上面（trigger_backfill 的 gate 读 CIVIC_POLLS_ENABLED）。这三个是
# 既有代码默认（生产同值），不是本批新开关。
CIVIC_POLLS_ENABLED=true
CIVIC_POLL_DAYS=3
CIVIC_NPC_CHOICE_LEGACY=false

# F3/S2-1 职位实体化：false → offices 表不读不写，nightly term_check 整段跳过
POLIS_OFFICE_ENABLED=false
POLIS_OFFICE_MAYOR_TERM_DAYS=0
POLIS_OFFICE_VACANCY_ALERT_HOURS=24.0

# F1/S1-1 公共声誉轴（REP_CREDIT_MIN_SCORE 已按 vm212 真实分布标定：0.0058，拒绝面 2/11，
# 证据见 docs/reports/2026-08-05-rep-gate-assessment.md；开闸走该报告 §5 六步单）
REP_ENABLED=false
REP_MIN=-1.0
REP_MAX=1.0
REP_NEUTRAL=0.0
REP_EMA_ALPHA=0.3
REP_GOSSIP_BASE_TONE=-0.3
REP_DISTORTION_PENALTY=-0.2
REP_MOOD_WEIGHT=0.2
REP_VOTE_TRUST_WEIGHT=1.0
REP_CREDIT_MIN_SCORE=0.0058

# F2 公民权晋升/撤销三态闸门：off=零读零写；shadow=只算名单不写库；on=真晋升
CIVIC_PROMOTION_MODE=off
CIVIC_AUTO_DEMOTION_ENABLED=false
# ⚠️ 下面三个门槛是占位值：mode=on 会被 assert_thresholds_calibrated 拒绝，
# 必须先用 scripts/civic_calibration_report.py 实测标定
CIVIC_PROMOTION_MIN_WORLD_DAYS=30.0
CIVIC_PROMOTION_MIN_PEERS=3
CIVIC_PROMOTION_MIN_FAMILIARITY=0.20
CIVIC_PEER_SEASONING_WORLD_DAYS=28.0
CIVIC_PROMOTION_MAX_PER_RUN=5
CIVIC_PROMOTION_BREAKER_FRACTION=0.20
CIVIC_PROMOTION_BREAKER_MIN_ABS=3
CIVIC_MIN_ELECTORATE=3
CIVIC_MIN_TENURE_WORLD_DAYS=12.0
CIVIC_PROMOTION_COOLDOWN_WORLD_DAYS=12.0
# 实测分布恰好落在占位值上时的显式标定凭据（值写报告日期/commit），平时保持注释
#CIVIC_THRESHOLDS_CALIBRATED=

# ── M-A 经济内生化（NPC↔NPC 真实钱流）─────────────────────────────────
# 三个闸门互相独立、默认全关 → 行为与现状逐字节一致。开闸顺序按
# docs/superpowers/specs/2026-08-09-npc-economy-design.md §7：先随代码暗上
# （迁移 055 落库、三闸读数 false），再单独变更开 NPC_TRADE_ENABLED +
# TAX_CARRY_ENABLED，观察一晚 nightly 后再单独开 CARAVAN_ENABLED。
# ⚠️ TAX_CARRY_ENABLED 必须与本仓 TOWN_TREASURY_ENABLED 分开翻：镇库在产已开，
# carry 若不独立设闸，暗上就等于「迁移 + 在产玩家路径行为变更」同车（红线）。

# C1 餐费入账 + C2 NPC 消费 pass + C3 NPC 接单/结算（nightly 段落 #23）
NPC_TRADE_ENABLED=false
NPC_TRADE_BUY_PROB=0.25
NPC_TRADE_RESERVE_SC=5
NPC_TRADE_MAX_BUYS_PER_NIGHT=2

# C4 外来商队：绑集市日到访，摊位费入镇库 + 按预算收购居民作品 + 上架进口货
CARAVAN_ENABLED=false
CARAVAN_STALL_FEE_SC=5
CARAVAN_BUDGET_SC=30

# C5 分数税账：税的尾数累进 system_config.town_tax_carry_milli；关 = 旧 int() 截断。
# 值是**整数 milli-SC**（1 SC = 1000），走数据库内原子增量，跨进程并发不丢尾数。
# 开闸后读数：select value from system_config where key='town_tax_carry_milli';
#            → 0 ≤ 值 < 1000（超过 1000 说明兑换那步没跑）
TAX_CARRY_ENABLED=false

# 加固：库存扣减走 items.stock 的 guarded UPDATE（cron 商队/夜间消费与玩家
# purchase 并发同一行不再超卖）。**前置：迁移 056 必须已落库**
# （select version_num from alembic_version → 056_add_item_stock）。
# 关 = 旧 payload_json 读-改-写，与现状逐字节一致 —— 迁移暗上一晚、观察
# 无异常后再单独翻这个键（红线：迁移与行为变更不同车）。
# 开闸后读数：select count(*) from items where stock < 0;  → 必须是 0
ITEM_STOCK_GUARD_ENABLED=false
