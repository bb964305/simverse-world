# PostgreSQL (used by docker-compose, overridden in environment block)
POSTGRES_PASSWORD=changeme

# Auth
JWT_SECRET=generate-a-64-char-random-string-here

# LLM (DashScope compatible endpoint)
LLM_API_KEY=sk-xxx
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# SearXNG (research)
SEARXNG_URL=http://localhost:58080

# Portrait generation (Gemini via proxy)
PORTRAIT_LLM_MODEL=gemini-3-pro-image-preview
PORTRAIT_LLM_BASE_URL=http://localhost:3000/v1
PORTRAIT_LLM_API_KEY=sk-xxx

# CORS — set to your Cloudflare Worker domain
CORS_ORIGINS=["https://skills-world.your-subdomain.workers.dev"]

# Lab production planes are default-off. Inject distinct secrets into each
# service workload instead of sharing this reference file in production.
LAB_ENABLED=false
LAB_ADAPTER=mock
LAB_MODEL_POLICY_VERSION=lab-deepseek-v1
LAB_PRO_MIN_REWARD_SC=100
LAB_FLASH_BUDGET_USD=0.25
LAB_PRO_BUDGET_USD=0.5
