LAB_ARTIFACT_SCANNER_RECEIPT_ISSUER=
LAB_ARTIFACT_CLEANUP_RECEIPT_ISSUER=
LAB_ARTIFACT_RECEIPT_ALGORITHM=EdDSA
# issuer -> {kid: absolute read-only Ed25519 public-key PEM path}; current +
# next keys are required per issuer. JSON paths must point inside the mounted
# /run/secrets/lab-artifact-receipt-trust directory in API/Runner workloads.
LAB_ARTIFACT_RECEIPT_KEYS_JSON={}
# Host directory containing the public PEM files referenced by the JSON above.
LAB_ARTIFACT_RECEIPT_TRUST_HOST_DIR=
LAB_ARTIFACT_SCANNER_CLAIM_SECONDS=300
LAB_ARTIFACT_SCANNER_POLICY_TIMEOUT_SECONDS=120
LAB_ARTIFACT_SCANNER_PARSER_TIMEOUT_SECONDS=30
LAB_ARTIFACT_SCANNER_PARSER_MAX_MEMORY_BYTES=536870912
LAB_ARTIFACT_SCANNER_MAX_ARCHIVE_DEPTH=3
LAB_ARTIFACT_SCANNER_MAX_ARCHIVE_FILES=1000
LAB_ARTIFACT_SCANNER_MAX_ARCHIVE_EXPANDED_BYTES=524288000
LAB_ARTIFACT_SCANNER_MAX_NESTED_ARCHIVE_BYTES=33554432
LAB_ARTIFACT_SCANNER_MAX_ARCHIVE_RATIO=100
LAB_ARTIFACT_SCANNER_MAX_IMAGE_PIXELS=100000000
LAB_ARTIFACT_SCANNER_MAX_IMAGE_DECODED_BYTES=536870912
LAB_ARTIFACT_SCANNER_MAX_TEXT_FIELD_BYTES=1048576
LAB_ARTIFACT_SCANNER_MAX_CSV_COLUMNS=4096
LAB_ARTIFACT_INGEST_RECEIPT_ALGORITHM=EdDSA
# Compose maps each HOST_PATH to the fixed workload-local PATH read-only.
LAB_ARTIFACT_INGEST_RECEIPT_PRIVATE_KEY_PATH=
LAB_ARTIFACT_INGEST_RECEIPT_PRIVATE_KEY_HOST_PATH=
LAB_ARTIFACT_SCANNER_RECEIPT_ALGORITHM=EdDSA
LAB_ARTIFACT_SCANNER_RECEIPT_PRIVATE_KEY_PATH=
LAB_ARTIFACT_SCANNER_RECEIPT_PRIVATE_KEY_HOST_PATH=
LAB_ARTIFACT_CLEANUP_RECEIPT_ALGORITHM=EdDSA
LAB_ARTIFACT_CLEANUP_RECEIPT_PRIVATE_KEY_PATH=
LAB_ARTIFACT_CLEANUP_RECEIPT_PRIVATE_KEY_HOST_PATH=
LAB_ARTIFACT_DOWNLOAD_BACKEND=
LAB_ARTIFACT_DOWNLOAD_STORAGE_ROOT=
LAB_ARTIFACT_DOWNLOAD_RELEASED_BUCKET=
LAB_ARTIFACT_DOWNLOAD_S3_ENDPOINT_URL=
LAB_ARTIFACT_DOWNLOAD_S3_REGION=
LAB_ARTIFACT_DOWNLOAD_S3_ACCESS_KEY=
LAB_ARTIFACT_DOWNLOAD_S3_SECRET_KEY=
LAB_ARTIFACT_DOWNLOAD_S3_SESSION_TOKEN=
LAB_ARTIFACT_DOWNLOAD_TIMEOUT_S=30
LAB_ARTIFACT_DOWNLOAD_MAX_BYTES=104857600

# LinuxDo OAuth (optional)
LINUXDO_CLIENT_ID=
LINUXDO_CLIENT_SECRET=
LINUXDO_REDIRECT_URI=

# Resident autonomous behavior (AgentLoop, runs in the agent-worker service).
# Production default has been OFF historically — set true to bring residents
# to life (movement, self-directed chats, feed events).
AGENT_ENABLED=true

# Static files (uploaded media, AI portraits, and approved resident sprites)
# are served from /app/static inside the container and persisted by the
# media_static volume. Unapproved sprite candidates stay in the separate,
# non-public resident_sprite_artifacts volume.
STATIC_DIR=/app/static
MEDIA_UPLOAD_DIR=/app/static/uploads
RESIDENT_SPRITE_ENABLED=false
RESIDENT_SPRITE_ARTIFACT_DIR=/var/lib/simverse/resident-sprites
# Provider credentials and generation pricing belong in the worker-only
# resident-sprite-worker.env file; never place them in this shared file.
# Qualified receipt is mounted read-only into the agent-worker. Set both vars
# only after probe/qualification/review has produced a current receipt.
# Container path is fixed by compose; configure the host-side source below.
RESIDENT_SPRITE_CAPABILITY_RECEIPT=/run/secrets/resident-sprite-capability.json
RESIDENT_SPRITE_CAPABILITY_RECEIPT_HOST_PATH=
RESIDENT_SPRITE_REVOCATION_ROOT=/var/lib/simverse/resident-sprites/revocations

# Observability. /metrics is served by the API process itself; with an empty
# METRICS_TOKEN it is unauthenticated and leaks every /admin/* route name and
# its call volume. Binding the API to loopback only blocks *direct* access to
# the port — cloudflared (or any reverse proxy) still forwards the whole
# origin, so https://<api-host>/metrics stays reachable from the public
# internet through the tunnel. Fail closed: leave this disabled until you set
# a real METRICS_TOKEN below, then flip it to true for your Prometheus
# scrape_config's bearer_token.
METRICS_ENABLED=false
METRICS_TOKEN=
