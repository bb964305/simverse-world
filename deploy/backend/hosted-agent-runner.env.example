# Copy this file to hosted-agent-runner.env on the deployment host only.
# It is loaded exclusively by api and hosted-agent-worker. Never merge these
# values into the shared .env or expose them to bootstrap/world/lab workloads.
HOSTED_AGENT_RUNNER_ENABLED=true
HOSTED_AGENT_RUNNER_ACTIVE_KEY_ID=replace-with-versioned-key-id
# JSON object of base64url-encoded, exactly 32-byte AES-GCM keys. Retain old
# entries while envelopes encrypted under them still exist.
HOSTED_AGENT_RUNNER_KEYRING={"replace-with-versioned-key-id":"replace-with-base64url-32-byte-key"}
# Exact provider hosts (or explicit *.example.com wildcard entries). Empty is
# rejected in non-debug deployments.
HOSTED_AGENT_RUNNER_ALLOWED_HOSTS=["api.openai.com"]
HOSTED_AGENT_RUNNER_INTERNAL_API_BASE=http://api:8000
HOSTED_AGENT_RUNNER_MAX_CONCURRENT=3
HOSTED_AGENT_RUNNER_LLM_TIMEOUT_SECONDS=60
HOSTED_AGENT_RUNNER_LEASE_SECONDS=180
HOSTED_AGENT_RUNNER_POLL_SECONDS=2
HOSTED_AGENT_RUNNER_MAX_RESPONSE_BYTES=262144
