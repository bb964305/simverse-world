LAB_CODEX_RUNTIME_BIND_HOST=0.0.0.0
LAB_CODEX_RUNTIME_BIND_PORT=8097
LAB_CODEX_RUNTIME_API_KEY_FILE=/run/secrets/runtime_api_key
LAB_CODEX_RUNTIME_BINARY=/usr/local/bin/codex
LAB_CODEX_RUNTIME_WORKSPACE_ROOT=/var/lib/simverse/codex-runs
LAB_CODEX_RUNTIME_MAX_ACTIVE_RUNS=2
LAB_CODEX_RUNTIME_RUN_TIMEOUT_S=1200
LAB_CODEX_RUNTIME_MODEL_GATEWAY_BASE_URL=http://model-gateway:8096/v1
LAB_CODEX_RUNTIME_SANDBOX=workspace-write
LAB_CODEX_RUNTIME_TOTAL_CPU_CORES=4
LAB_CODEX_RUNTIME_TOTAL_MEMORY_MB=8192
# Set by runtime-entrypoint after it delegates this container's Docker scope.
LAB_CODEX_RUNTIME_SESSION_TTL_S=3600
LAB_CODEX_RUNTIME_MAX_SESSIONS=128
LAB_CODEX_RUNTIME_USAGE_POLL_S=5
