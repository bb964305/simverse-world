VITE_API_URL=http://localhost:8000
VITE_WEB3_CHAIN_ID=84532
VITE_WEB3_CHAIN_NAME=Base Sepolia
VITE_WEB3_RPC_URL=https://sepolia.base.org
# Optional. Without it RabbyKit exposes injected browser wallets only.
VITE_WALLETCONNECT_PROJECT_ID=
# UUPS proxy address emitted by `npm run deploy:local` in ../contracts.
VITE_AGENT_REGISTRY_ADDRESS=
VITE_RESIDENT_SPRITE_ENABLED=false
# Optional: enables Sentry error reporting (loaded as an async chunk, zero
# first-load cost when unset)
VITE_SENTRY_DSN=
